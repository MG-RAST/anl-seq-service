#!/usr/bin/env python3
"""Poll an NCBI submission folder for terminal status + extract accessions.

Post-`submit.ready`, NCBI writes intermediate `report.N.xml` files and
overwrites `report.xml` in place as processing progresses. The terminal
status (processed-ok / processed-error) appears in whichever report has
the newest last_update — usually the plain `report.xml`.

Bug this tool fixes (relative to earlier ad-hoc `/tmp/poll-*.py` scripts):
those tracked "already seen" by filename only, so they cached the initial
"submitted" version of report.xml and never re-fetched it as NCBI
updated the same filename. This script always re-fetches every report on
every iteration (files are <100 KB).

On terminal success, writes accessions.tsv (sample_name -> SAMN -> SRR)
next to the saved reports. See feedback-poll-gotchas memory for context.
"""

import argparse
import io
import logging
import os
import re
import sys
import time
import xml.etree.ElementTree as ET
from datetime import datetime, timezone

try:
    import paramiko
except ImportError:
    paramiko = None

logger = logging.getLogger(__name__)

DEFAULT_HOSTS = {
    "sftp": "sftp-private.ncbi.nlm.nih.gov",
    "ftp":  "ftp-private.ncbi.nlm.nih.gov",
}
DEFAULT_PORTS = {"sftp": 22, "ftp": 21}


def _sftp_connect(host, port, user, pwd):
    if paramiko is None:
        raise RuntimeError("paramiko required for SFTP; pip install paramiko")
    c = paramiko.SSHClient()
    c.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    c.connect(host, port=port, username=user, password=pwd, timeout=30,
              allow_agent=False, look_for_keys=False)
    return c, c.open_sftp()


def _ftp_connect(host, port, user, pwd):
    import ftplib
    f = ftplib.FTP()
    f.connect(host, port, timeout=30)
    f.login(user, pwd)
    return f


def _list_and_fetch_reports(transport, sess, folder, save_dir):
    """List folder, download every report*.xml, return list of local paths in
    filename-sorted order. Always overwrites — that's the whole point."""
    if transport == "sftp":
        sftp = sess
        try:
            sftp.chdir("/")
            sftp.chdir(folder)
        except Exception as e:
            raise RuntimeError(f"cwd {folder}: {e}")
        entries = sftp.listdir()
    else:
        ftp = sess
        ftp.cwd("/")
        ftp.cwd(folder)
        entries = ftp.nlst()

    reports = sorted([e for e in entries
                      if e.startswith("report") and e.endswith(".xml")])
    local_paths = []
    for r in reports:
        local = os.path.join(save_dir, r)
        try:
            if transport == "sftp":
                sftp.get(r, local)
            else:
                with open(local, "wb") as fh:
                    ftp.retrbinary(f"RETR {r}", fh.write)
            local_paths.append(local)
        except Exception as e:
            logger.warning("Failed to fetch %s: %s", r, e)
    return reports, local_paths


def _latest_terminal(local_paths):
    """Find the terminal report if any; return (path, root_element, is_terminal).

    Terminal = root SubmissionStatus.status is processed-ok or processed-error.
    NCBI sometimes writes terminal status to a later report.N.xml and leaves
    the plain report.xml at an earlier status, so we check the file with the
    NEWEST <SubmissionStatus last_update="..."> attribute across all reports.
    """
    best = None  # (last_update_str, path, root, status)
    for p in local_paths:
        try:
            root = ET.parse(p).getroot()
        except ET.ParseError:
            continue
        status = root.attrib.get("status", "")
        lu = root.attrib.get("last_update", "")
        if best is None or lu > best[0]:
            best = (lu, p, root, status)
    if best is None:
        return None, None, False
    _, path, root, status = best
    is_terminal = status in ("processed-ok", "processed-error")
    return path, root, is_terminal


def _extract_accessions(root):
    """Yield (sample_name, samn, srr) tuples from a terminal report.

    Reads accessions from <Object accession="..."> attributes; SRA-side
    SPUIDs have an 'SRA_' prefix, BioSample-side don't. See
    feedback-poll-gotchas memory for context on why we read the attribute
    rather than a nested <PrimaryId>.
    """
    by_sample = {}
    for obj in root.iter("Object"):
        sp = obj.attrib.get("spuid", "").strip()
        acc = obj.attrib.get("accession", "").strip()
        if not sp or not acc:
            continue
        key = sp[4:] if sp.startswith("SRA_") else sp
        d = by_sample.setdefault(key, {})
        if acc.startswith("SAMN"):
            d["SAMN"] = acc
        elif acc.startswith("SRR"):
            d["SRR"] = acc
        elif acc.startswith("SRX"):
            d.setdefault("SRX", acc)  # useful but not always shown
    return sorted(by_sample.items(),
                  key=lambda kv: int(kv[0]) if kv[0].isdigit() else 0)


def _summarise(root):
    """One-line breakdown of actions by status for the log."""
    actions = root.findall("Action")
    by_st = {}
    for a in actions:
        s = a.attrib.get("status", "?")
        by_st[s] = by_st.get(s, 0) + 1
    return f"actions={by_st}"


def cli():
    p = argparse.ArgumentParser(
        description="Poll an NCBI submission folder until terminal status + "
                    "emit sample_name -> SAMN -> SRR accession TSV.")
    p.add_argument("--folder", required=True,
                   help="Remote folder path relative to /, e.g. "
                        "submit/Production/PRJNA989260_240612_..._<ts>")
    p.add_argument("--transport",
                   default=os.environ.get("NCBI_TRANSPORT", "sftp"),
                   choices=["sftp", "ftp"])
    p.add_argument("--host", default=os.environ.get("NCBI_HOST"))
    p.add_argument("--port", type=int,
                   default=int(os.environ["NCBI_PORT"]) if os.environ.get("NCBI_PORT") else None)
    p.add_argument("--user", default=os.environ.get("NCBI_USER"),
                   help="default: $NCBI_USER")
    p.add_argument("--password", default=os.environ.get("NCBI_PASSWORD"),
                   help="default: $NCBI_PASSWORD")
    p.add_argument("--save-dir", default=None,
                   help="Where to save downloaded reports + accessions.tsv "
                        "(default: ./poll-<basename(folder)>/)")
    p.add_argument("--interval", type=int, default=60,
                   help="Poll interval in seconds (default 60)")
    p.add_argument("--max-hours", type=float, default=6.0,
                   help="Bail after this many hours (default 6)")
    p.add_argument("--log-level", default="INFO",
                   choices=["DEBUG", "INFO", "WARNING", "ERROR"])
    args = p.parse_args()

    logging.basicConfig(format="%(levelname)s %(asctime)s\t%(message)s",
                        level=args.log_level)

    if not args.host: args.host = DEFAULT_HOSTS[args.transport]
    if not args.port: args.port = DEFAULT_PORTS[args.transport]
    for name in ("user", "password"):
        if not getattr(args, name):
            logger.error("Missing --%s or $NCBI_%s", name, name.upper())
            sys.exit(2)

    save_dir = args.save_dir or f"poll-{os.path.basename(args.folder)}"
    save_dir = os.path.abspath(save_dir)
    os.makedirs(save_dir, exist_ok=True)
    logger.info("Saving to %s", save_dir)

    deadline = time.time() + args.max_hours * 3600
    started = datetime.now(timezone.utc)
    iter_n = 0
    prev_count = None

    while time.time() < deadline:
        iter_n += 1
        elapsed_min = (time.time() - started.timestamp()) / 60

        # Fresh connection each iteration — cheap and avoids stale-session issues.
        try:
            if args.transport == "sftp":
                cli_, sess = _sftp_connect(args.host, args.port, args.user, args.password)
            else:
                sess = _ftp_connect(args.host, args.port, args.user, args.password)
                cli_ = None
        except Exception as e:
            logger.error("[iter %d] connect failed: %s", iter_n, e)
            time.sleep(args.interval)
            continue

        try:
            reports, local_paths = _list_and_fetch_reports(args.transport, sess,
                                                           args.folder, save_dir)
        except Exception as e:
            logger.error("[iter %d] list/fetch failed: %s", iter_n, e)
            reports, local_paths = [], []
        finally:
            try:
                if args.transport == "sftp":
                    sess.close(); cli_.close()
                else:
                    sess.quit()
            except Exception:
                pass

        msg = f"[iter {iter_n}] elapsed {elapsed_min:.1f}m; reports={reports}"
        if prev_count is not None and prev_count != len(reports):
            msg += f" (was {prev_count})"
        prev_count = len(reports)

        if not local_paths:
            logger.info(msg)
            time.sleep(args.interval)
            continue

        latest_path, root, is_terminal = _latest_terminal(local_paths)
        summary = _summarise(root) if root is not None else "actions=?"
        latest_name = os.path.basename(latest_path) if latest_path else "?"
        status_now = root.attrib.get("status", "?") if root is not None else "?"
        logger.info("%s; latest=%s status=%s %s",
                    msg, latest_name, status_now, summary)

        if is_terminal:
            logger.info("=" * 60)
            logger.info("TERMINAL: %s in %s after %.1fm",
                        status_now, latest_name, elapsed_min)
            logger.info("=" * 60)
            acc_path = os.path.join(save_dir, "accessions.tsv")
            with open(acc_path, "w") as fh:
                fh.write("sample_name\tSAMN\tSRR\tSRX\n")
                for sample, d in _extract_accessions(root):
                    fh.write(f"{sample}\t{d.get('SAMN','')}\t"
                             f"{d.get('SRR','')}\t{d.get('SRX','')}\n")
            logger.info("Wrote accession mapping: %s", acc_path)
            sys.exit(0 if status_now == "processed-ok" else 3)

        time.sleep(args.interval)

    logger.warning("Timeout after %.1fh without terminal status "
                   "(the submission may still be in flight — re-run this "
                   "tool later to catch it)", args.max_hours)
    sys.exit(1)


if __name__ == "__main__":
    cli()
