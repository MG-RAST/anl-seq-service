#!/bin/bash

# Generate NCBI SRA + BioSample submission package from a run folder.
#
# Workflow:
#   1. Discover templates and NWSS sample CSVs in <run_folder>/SRA/
#   2. Run SRA.py to produce final run.tsv and Biosample.tsv from templates
#   3. Run sra_xml.py to produce submission.xml from those TSVs
#
# Runs natively with system python3 (-l), or via singularity/docker if one
# is on PATH. Falls back to local when no container runtime is found.
#
# Phase 2 (not yet implemented): -p will upload the package to NCBI's
# submission FTP using NCBI_USER / NCBI_PASSWORD / NCBI_BASE_DIR.

# Constants
DEBUG=0
UPDATE=0
UPLOAD=0
NO_TRIGGER=0
LOCAL=0
HELP=0
SKIP_LIST=""
SKIP_PUBLISHED=0
BLACKLIST_OUT=""
IMAGE="wilke/anl-seq-service"
TAG=latest
LOG_LEVEL=INFO

# Resolve symlinks so invocations via /local/incoming/covid/scripts/sra-upload
# (which symlinks here) still find the sibling lib/python correctly.
SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
HOST_LIB_DIR=$(cd "${SCRIPT_DIR}/../lib/python" && pwd)
CONTAINER_LIB_DIR=/anl-seq-service/lib/python

if [ -z "${NCBI_CONTACT}" ] ; then
    cat <<EOF >&2
ERROR: NCBI_CONTACT is not set.

Source the project auth file to populate all required env vars:
    source /nfs/seq-data/anl-seq-service/config/auth.sh

That sets NCBI_CONTACT (+ NCBI_USER, NCBI_PASSWORD, NCBI_BASE_DIR
for -p).
EOF
    exit 1
fi

# Preflight: refuse to run if the auth file is too permissive.
# Group-readable at 640 is acceptable (espsf-seq is the operator group);
# world-readable at 644+ or writable at 6[4-7][2367] is not.
AUTH_FILE=/nfs/seq-data/anl-seq-service/config/auth.sh
if [ -f "$AUTH_FILE" ] ; then
    AUTH_MODE=$(stat -c "%a" "$AUTH_FILE")
    case "$AUTH_MODE" in
        600|640) ;;
        *)
            echo "ERROR: $AUTH_FILE has mode $AUTH_MODE (must be 600 or 640)." >&2
            echo "  Run: chmod 640 $AUTH_FILE" >&2
            exit 1
            ;;
    esac
fi

function usage {
echo "Generate NCBI SRA + BioSample submission package for a run folder"
echo --------------------------------------------------
echo "Usage: $0 [-h] [-d] [-l] [-u] [-p] -r <run folder>"
echo "-r : Run folder containing SRA/ subdir with templates"
echo "-d : Dry-run ; debugging"
echo "-l : Run locally with system python3 (no container)"
echo "-u : Update container image"
echo "-p : Push package (fastqs + submission.xml + submit.ready) to NCBI submission FTP"
echo "-T : With -p, upload everything except submit.ready (no trigger; safer first test)"
echo "-s <file> : Skip sample IDs listed in <file> (from check-published-samples or plain list)"
echo "-S : Auto-generate skip list via check-published-samples before generating TSVs"
echo "-B <file> : Write blacklist of template samples missing from NWSS (default: ./blacklist.<batch>.tsv)"
echo ""
echo "Optional environment:"
echo "  NWSS_MASTER_DIR   Master NWSS reference dir (default: /incoming/SRA_COVID_Temp)"
echo ""
echo "Required environment variables:"
echo "  NCBI_CONTACT      Submitter contact email"
echo ""
echo "Environment variables for -p:"
echo "  NCBI_USER         NCBI submission FTP username"
echo "  NCBI_PASSWORD     NCBI submission FTP password"
echo "  NCBI_BASE_DIR     Account folder on ftp-private.ncbi.nlm.nih.gov"
echo "  NCBI_HOST         (Optional) Override FTP host"
}

while getopts hr:dlupTs:SB: option; do
    case "${option}" in
        h) HELP=1 ;;
        r) RUN_FOLDER=${OPTARG} ;;
        d) DEBUG=1 ;;
        l) LOCAL=1 ;;
        u) UPDATE=1 ;;
        p) UPLOAD=1 ;;
        T) NO_TRIGGER=1 ;;
        s) SKIP_LIST=${OPTARG} ;;
        S) SKIP_PUBLISHED=1 ;;
        B) BLACKLIST_OUT=${OPTARG} ;;
        *) usage ; exit 1 ;;
    esac
done

if [ -n "$SKIP_LIST" ] && [ $SKIP_PUBLISHED -eq 1 ] ; then
    echo "ERROR: -s <file> and -S are mutually exclusive." >&2
    exit 1
fi

if [ $HELP -eq 1 ] ; then
    usage
    exit 0
fi

if [ -z "${RUN_FOLDER}" ] ; then
    usage
    exit 1
fi

if [ $UPLOAD -eq 1 ] ; then
    for v in NCBI_USER NCBI_PASSWORD NCBI_BASE_DIR ; do
        if [ -z "${!v}" ] ; then
            cat <<EOF >&2
ERROR: $v is not set (required when -p is used).

Source the project auth file to populate all NCBI_* vars:
    source /nfs/seq-data/anl-seq-service/config/auth.sh
EOF
            exit 1
        fi
    done
fi

if [ ! -d "${RUN_FOLDER}" ] ; then
    echo "ERROR: Run folder not found: ${RUN_FOLDER}"
    echo "  (did you mean /local/incoming/nextseq2k_output/nextseq2k_runs/... ?)"
    exit 1
fi
if [ ! "${RUN_FOLDER:0:1}" = "/" ] ; then
    RUN_FOLDER="$(cd "$(dirname "${RUN_FOLDER}")" && pwd)/$(basename "${RUN_FOLDER}")"
fi
# Normalize trailing slash so basename works predictably downstream.
RUN_FOLDER="${RUN_FOLDER%/}"

# Templates live per-batch (hand-curated) and MUST be under <run_folder>/SRA/.
# Constrain discovery to that dir so stale snapshots elsewhere can't be picked.
RUN=$(find "${RUN_FOLDER}/SRA" -maxdepth 2 -iname "*.run.tmpl.tsv" 2>/dev/null)
if [ -z "${RUN}" ] ; then
    RUN=$(find "${RUN_FOLDER}/SRA" -maxdepth 2 -iname "*.sra.tmpl.tsv" 2>/dev/null)
fi
BIOSAMPLE=$(find "${RUN_FOLDER}/SRA" -maxdepth 2 -iname "*.biosample.tmpl.tsv" 2>/dev/null)

# NWSS reference files (SiteID, IDPH, CDPH) come from the master dir. Batch-local
# copies are ignored — they get stale/reverted. Master is a longitudinal
# cumulative record maintained by the NWSS reporting side.
NWSS_MASTER_DIR="${NWSS_MASTER_DIR:-/incoming/SRA_COVID_Temp}"
NWSS_MASTER_DIR="${NWSS_MASTER_DIR%/}"

if [ ! -d "$NWSS_MASTER_DIR" ] ; then
    echo "ERROR: NWSS master dir not found: $NWSS_MASTER_DIR" >&2
    echo "  Set NWSS_MASTER_DIR env var to override the default." >&2
    exit 1
fi

# SiteID: master file (single file, no dating).
SITES="${NWSS_MASTER_DIR}/SiteID.tsv"

# IDPH + CDPH: pick the LATEST by mtime among matching files. Filenames are
# dated MM_DD_YYYY_NWSS_{IDPH,CDPH}.csv but MM_DD_YYYY doesn't sort chronologically
# so use mtime instead. Ignore ._* macOS metadata files.
IDPH=$(ls -t "$NWSS_MASTER_DIR"/*_NWSS_IDPH.csv 2>/dev/null \
       | grep -v '/\._' | head -1)
CDPH=$(ls -t "$NWSS_MASTER_DIR"/*_NWSS_CDPH.csv 2>/dev/null \
       | grep -v '/\._' | head -1)

STOP=0
for i in RUN BIOSAMPLE SITES IDPH CDPH ; do
    val="${!i}"
    n=$(printf '%s\n' "$val" | grep -c .)
    if [ "$n" -ne 1 ] || [ ! -f "$val" ] ; then
        STOP=1
        echo "ERROR: $i lookup produced $n hit(s), expected 1 real file:" >&2
        printf '  %s\n' "$val" >&2
    fi
done
if [ $STOP -eq 1 ] ; then
    exit 1
fi

# Output paths
BIOSAMPLE_FILE_PATH=$(dirname "$BIOSAMPLE")
BIOSAMPLE_FILE_DEST="${BIOSAMPLE_FILE_PATH}/$(basename -s .tmpl.tsv "$BIOSAMPLE").tsv"
RUN_FILE_PATH=$(dirname "$RUN")
RUN_FILE_DEST="${RUN_FILE_PATH}/$(basename -s .tmpl.tsv "$RUN").tsv"
SUBMISSION_XML="${RUN_FOLDER}/SRA/submission/submission.xml"

# Merge IDPH + CDPH samples into samples.csv consumed by SRA.py.
# If both files present but headers differ, use the wider one and warn — SRA.py
# will pad short rows. This handles the IDPH-adds-days_in_sewer case.
if [ -f "${IDPH}" ] && [ -f "${CDPH}" ] ; then
    IDPH_NCOL=$(head -n 1 "${IDPH}" | awk -F, '{print NF}')
    CDPH_NCOL=$(head -n 1 "${CDPH}" | awk -F, '{print NF}')
    if [ "$IDPH_NCOL" != "$CDPH_NCOL" ] ; then
        echo "WARNING: IDPH ($IDPH_NCOL cols) and CDPH ($CDPH_NCOL cols) headers differ; using wider one and padding."
    fi
    if [ "$IDPH_NCOL" -ge "$CDPH_NCOL" ] ; then
        HEADER_SRC="${IDPH}"
    else
        HEADER_SRC="${CDPH}"
    fi
else
    HEADER_SRC="${IDPH:-$CDPH}"
fi
if [ -z "${HEADER_SRC}" ] || [ ! -f "${HEADER_SRC}" ] ; then
    echo "ERROR: Missing IDPH and CDPH sample files"
    exit 1
fi
head -n 1 "${HEADER_SRC}" > "${RUN_FOLDER}/SRA/samples.csv"
for f in "${IDPH}" "${CDPH}" ; do
    [ -n "$f" ] && [ -f "$f" ] && tail -n +2 "$f" >> "${RUN_FOLDER}/SRA/samples.csv"
done
SAMPLES="${RUN_FOLDER}/SRA/samples.csv"

DOCKER=`which docker`
SINGULARITY=`which singularity`

if [ $LOCAL -eq 1 ] ; then
    RUNTIME=local
elif [ ! -z "$SINGULARITY" ] ; then
    RUNTIME=singularity
elif [ ! -z "$DOCKER" ] ; then
    RUNTIME=docker
else
    RUNTIME=local
    echo "No container runtime found; using system python3."
fi

case "$RUNTIME" in
    local)
        EXEC=""
        LIB_DIR="${HOST_LIB_DIR}"
        ;;
    singularity)
        if [ $UPDATE -eq 1 ] ; then
            [ ${DEBUG} -eq 1 ] && echo "singularity pull docker://${IMAGE}:${TAG}" \
                              || singularity pull docker://${IMAGE}:${TAG}
        fi
        # Propagate secrets via SINGULARITYENV_* rather than --env <k>=<v>
        # so values never appear in argv (ps auxww leak).
        export SINGULARITYENV_NCBI_CONTACT="$NCBI_CONTACT"
        if [ $UPLOAD -eq 1 ] ; then
            export SINGULARITYENV_NCBI_USER="$NCBI_USER"
            export SINGULARITYENV_NCBI_PASSWORD="$NCBI_PASSWORD"
            export SINGULARITYENV_NCBI_BASE_DIR="$NCBI_BASE_DIR"
            [ -n "${NCBI_HOST}" ] && export SINGULARITYENV_NCBI_HOST="$NCBI_HOST"
        fi
        # Extra binds so the container can read master NWSS + write the
        # blacklist file (which defaults to CWD).
        EXTRA_BINDS="--bind ${NWSS_MASTER_DIR}:${NWSS_MASTER_DIR}:ro"
        EXTRA_BINDS="$EXTRA_BINDS --bind $(pwd):$(pwd)"
        EXEC="singularity exec --bind $RUN_FOLDER:$RUN_FOLDER $EXTRA_BINDS docker://${IMAGE}:${TAG}"
        LIB_DIR="${CONTAINER_LIB_DIR}"
        ;;
    docker)
        if [ $UPDATE -eq 1 ] ; then
            [ ${DEBUG} -eq 1 ] && echo "docker pull ${IMAGE}:${TAG}" \
                              || docker pull ${IMAGE}:${TAG}
        fi
        # Bare -e <NAME> tells docker to inherit from the parent env,
        # so secret values never land in argv (ps auxww leak).
        DOCKER_ENV="-e NCBI_CONTACT"
        if [ $UPLOAD -eq 1 ] ; then
            DOCKER_ENV="$DOCKER_ENV -e NCBI_USER -e NCBI_PASSWORD -e NCBI_BASE_DIR"
            [ -n "${NCBI_HOST}" ] && DOCKER_ENV="$DOCKER_ENV -e NCBI_HOST"
        fi
        # Extra mounts for master NWSS (ro) + CWD (rw for blacklist output).
        EXTRA_MOUNTS="-v ${NWSS_MASTER_DIR}:${NWSS_MASTER_DIR}:ro"
        EXTRA_MOUNTS="$EXTRA_MOUNTS -v $(pwd):$(pwd)"
        EXEC="${DOCKER} run --rm -v $RUN_FOLDER:$RUN_FOLDER $EXTRA_MOUNTS $DOCKER_ENV ${IMAGE}:${TAG}"
        LIB_DIR="${CONTAINER_LIB_DIR}"
        ;;
esac

if [ ${DEBUG} -eq 1 ] ; then
    echo Files:
    echo ------------------------
    echo NWSS MASTER DIR: $NWSS_MASTER_DIR
    echo BLACKLIST OUT:   $BLACKLIST_OUT
    echo RUN TEMPLATE:    $RUN
    echo RUN OUTPUT:      $RUN_FILE_DEST
    echo BIOSAM. TMPL:    $BIOSAMPLE
    echo BIOSAM. OUTPUT:  $BIOSAMPLE_FILE_DEST
    echo SITES:           $SITES
    echo IDPH:            $IDPH
    echo CDPH:            $CDPH
    echo SUBMISSION XML:  $SUBMISSION_XML
    echo
    echo Options:
    echo ------------------------
    echo RUNTIME:     $RUNTIME
    echo HELP:        $HELP
    echo UPDATE:      $UPDATE
    echo UPLOAD:      $UPLOAD
    echo DEBUG:       $DEBUG
    echo RUN_FOLDER:  ${RUN_FOLDER}
    echo NCBI_CONTACT:${NCBI_CONTACT}
    echo
fi

# Build the check-published-samples call for -S (auto-generate skip list).
CHECK_PUBLISHED_CMD=""
if [ $SKIP_PUBLISHED -eq 1 ] ; then
    SKIP_LIST="${RUN_FOLDER}/SRA/published.tsv"
    # The check runs locally on the host; the check-published-samples script
    # itself is portable stdlib and doesn't need the container.
    CHECK_PUBLISHED_CMD="${SCRIPT_DIR}/check-published-samples \
        -r ${RUN_FOLDER} \
        -o ${SKIP_LIST} \
        --log-level ${LOG_LEVEL}"
fi

# Add --skip-samples to SRA.py invocation if either -s or -S is active.
SKIP_ARG=""
if [ -n "$SKIP_LIST" ] ; then
    SKIP_ARG="--skip-samples ${SKIP_LIST}"
fi

# Blacklist output: default to ./blacklist.<batch>.tsv in CWD so it lands next
# to run.log / error.log per the SOP. Override with -B <path>.
if [ -z "$BLACKLIST_OUT" ] ; then
    BLACKLIST_OUT="$(pwd)/blacklist.$(basename "$RUN_FOLDER").tsv"
fi

TSV_CMD="${EXEC} python3 ${LIB_DIR}/SRA.py \
    --run-template ${RUN} \
    --run-output ${RUN_FILE_DEST} \
    --biosample-template ${BIOSAMPLE} \
    --biosample-output ${BIOSAMPLE_FILE_DEST} \
    --sites ${SITES} \
    --samples ${SAMPLES} \
    --sequence-dir ${RUN_FOLDER} \
    --blacklist-out ${BLACKLIST_OUT} \
    ${SKIP_ARG} \
    --log-level ${LOG_LEVEL}"

XML_CMD="${EXEC} python3 ${LIB_DIR}/sra_xml.py \
    --run-tsv ${RUN_FILE_DEST} \
    --biosample-tsv ${BIOSAMPLE_FILE_DEST} \
    --output ${SUBMISSION_XML} \
    --contact-email ${NCBI_CONTACT} \
    --log-level ${LOG_LEVEL}"

UPLOAD_CMD="${EXEC} python3 ${LIB_DIR}/ncbi_upload.py \
    --submission-xml ${SUBMISSION_XML} \
    --sequence-dir ${RUN_FOLDER} \
    --run-basename `basename ${RUN_FOLDER}` \
    --log-level ${LOG_LEVEL}"

if [ $NO_TRIGGER -eq 1 ] ; then
    UPLOAD_CMD="${UPLOAD_CMD} --no-trigger"
fi

if [ ${DEBUG} -eq 1 ] ; then
    if [ -n "$CHECK_PUBLISHED_CMD" ] ; then
        echo "STEP 0 (CHECK):   $CHECK_PUBLISHED_CMD"
    fi
    echo "STEP 1 (TSV):     $TSV_CMD"
    echo "STEP 2 (XML):     $XML_CMD"
    if [ $UPLOAD -eq 1 ] ; then
        echo "STEP 3 (UPLOAD):  $UPLOAD_CMD"
    fi
    exit 0
fi

# Capture each step's stderr+stdout to a step log so we can aggregate
# warnings at the end (WARNINGS scroll off in a long upload).
STEP_LOG=$(mktemp)
trap 'rm -f "$STEP_LOG"' EXIT

if [ -n "$CHECK_PUBLISHED_CMD" ] ; then
    echo "[0/3] Checking which samples are already published..."
    eval $CHECK_PUBLISHED_CMD 2>&1 | tee -a "$STEP_LOG"
    CHECK_STATUS=${PIPESTATUS[0]}
    [ $CHECK_STATUS -ne 0 ] && { echo "check-published-samples failed (exit $CHECK_STATUS)"; exit $CHECK_STATUS; }
fi

echo "[1/3] Generating TSVs..."
eval $TSV_CMD 2>&1 | tee -a "$STEP_LOG"
TSV_STATUS=${PIPESTATUS[0]}
[ $TSV_STATUS -ne 0 ] && { echo "TSV generation failed (exit $TSV_STATUS)"; exit $TSV_STATUS; }

echo "[2/3] Generating submission.xml..."
eval $XML_CMD 2>&1 | tee -a "$STEP_LOG"
XML_STATUS=${PIPESTATUS[0]}
[ $XML_STATUS -ne 0 ] && { echo "XML generation failed (exit $XML_STATUS)"; exit $XML_STATUS; }
echo "Wrote ${SUBMISSION_XML}"

if [ $UPLOAD -eq 1 ] ; then
    echo "[3/3] Uploading to NCBI..."
    eval $UPLOAD_CMD 2>&1 | tee -a "$STEP_LOG"
    UPLOAD_STATUS=${PIPESTATUS[0]}
    [ $UPLOAD_STATUS -ne 0 ] && { echo "Upload to NCBI failed (exit $UPLOAD_STATUS)"; exit $UPLOAD_STATUS; }
fi

# Aggregate warnings from all steps so operators see them even after
# the per-file upload stream scrolls the earlier ones off.
# Surface the skip-list summary distinctly (it's a design decision, not an error).
if [ -n "$SKIP_LIST" ] ; then
    SKIPPED_N=$(grep -oE "Skipped [0-9]+ of [0-9]+ template rows" "$STEP_LOG" | head -1 | awk '{print $2}')
    if [ -n "$SKIPPED_N" ] ; then
        echo
        echo "Filtered: $SKIPPED_N sample(s) skipped via ${SKIP_LIST}"
    fi
fi

# grep -c always prints a number even on 0 matches, but exits non-zero.
# Drop the || echo 0 fallback (which caused "0\n0" multi-line captures on
# match=0, breaking the -gt integer test below).
WARN_COUNT=$(grep -c "^WARNING" "$STEP_LOG" 2>/dev/null)
ERR_COUNT=$(grep -c "^ERROR" "$STEP_LOG" 2>/dev/null)
WARN_COUNT=${WARN_COUNT:-0}
ERR_COUNT=${ERR_COUNT:-0}
if [ "$WARN_COUNT" -gt 0 ] || [ "$ERR_COUNT" -gt 0 ] ; then
    echo
    echo "================================================================"
    echo "WARNINGS AND ERRORS DURING THIS RUN"
    echo "  $WARN_COUNT WARNING(s), $ERR_COUNT ERROR(s)"
    echo "================================================================"
    grep -E "^(WARNING|ERROR)" "$STEP_LOG" | head -40
    if [ $(grep -E "^(WARNING|ERROR)" "$STEP_LOG" | wc -l) -gt 40 ] ; then
        echo "... (more; full log lines above)"
    fi
    echo "================================================================"
fi
